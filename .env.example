# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Use a Merchant app linked to a US sandbox Business account, otherwise Payouts
# can fail with PAYOUT_NOT_AVAILABLE.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: only needed if you register a webhook for payout events.
PAYPAL_WEBHOOK_ID=

# Gemini API key from Google AI Studio (free tier is enough for the demo).
GEMINI_API_KEY=your_gemini_api_key

# Any long random string. Required to approve submissions as a maintainer.
MAINTAINER_TOKEN=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///./bountyguard.db
APP_ENV=development
